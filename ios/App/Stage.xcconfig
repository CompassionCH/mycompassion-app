// Stage build overrides. Attach this file to the "Stage" build configuration
// (Project ▸ Info ▸ Configurations ▸ Stage ▸ Based on Configuration File).
// Gives the test app a distinct bundle id (side-by-side install), name and icon.
PRODUCT_BUNDLE_IDENTIFIER = ch.mycompassion.app.dev
INFOPLIST_KEY_CFBundleDisplayName = MyCompassion Stage
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev
