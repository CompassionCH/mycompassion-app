// Stage build overrides. Attached to the "Stage" build configuration
// (Project ▸ Info ▸ Configurations ▸ Stage ▸ Based on Configuration File).
// Gives the test app its own bundle id, name, icon and URL scheme so it
// installs and hands back payments side by side with production.
PRODUCT_BUNDLE_IDENTIFIER = ch.mycompassion.app.dev
APP_DISPLAY_NAME = My Compassion Stage
APP_URL_SCHEME = mycompassion-stage
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev
